# ---------------------------------------------------------------------------
# Variables de entorno — copiar este archivo como .env.local y completar.
# NUNCA subir .env.local al repositorio (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase (OPCIONAL) ---------------------------------------------------
# Si estas variables no existen, la aplicacion funciona igual: guarda el
# progreso solo en el navegador del estudiante (localStorage).
#
# Se obtienen en: Supabase -> Project Settings -> Data API / API Keys
SUPABASE_URL=
# ATENCION: la service role key es SECRETA. No lleva el prefijo NEXT_PUBLIC_
# justamente para que Next.js nunca la envie al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel del docente -----------------------------------------------------
# Contrasena de acceso a /docente. Elegir una propia y no compartirla con
# los estudiantes.
TEACHER_PASSWORD=
