# ---------------------------------------------------------------------------
# Copiá este archivo como .env.local y completá los valores.
# En Vercel, cargá estas mismas variables en Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# 1) Planilla de Google -----------------------------------------------------
# El ID es la parte larga del link de tu Sheet:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Mail de la cuenta de servicio (termina en .iam.gserviceaccount.com).
# Acordate de compartir la planilla con este mail, como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada del archivo JSON que descargaste de Google Cloud.
# Copiala completa, entre comillas dobles, tal cual aparece (con los \n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# 2) Seguridad de las sesiones ---------------------------------------------
# Texto largo al azar. Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# 3) Usuario gerente de arranque (opcional) --------------------------------
# Sirve para poder entrar la primera vez, antes de cargar la hoja USUARIOS.
# El hash se genera con: npm run clave -- "TuContraseña"
ADMIN_USUARIO=
ADMIN_PASSWORD_HASH=
ADMIN_NOMBRE=Gerencia Zonal

# 4) Ajustes opcionales -----------------------------------------------------
# Segundos que se guardan los datos en memoria antes de releer la planilla.
CACHE_SEGUNDOS=60
